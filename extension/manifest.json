{
  "manifest_version": 3,
  "name": "HORIZON 投屏",
  "version": "0.5.0",
  "description": "把当前标签页或屏幕投到 HORIZON 会议主机：自动发现局域网内的接收端，输入大屏上的投屏码即可投放；另含文件传送与主机片库、投屏队列的排序管理。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "HORIZON 投屏",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "offscreen", "tabCapture", "system.network"],
  "host_permissions": ["http://*/*"],
  "background": {
    "service_worker": "background.js"
  }
}
