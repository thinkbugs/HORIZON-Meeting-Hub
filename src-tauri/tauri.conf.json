{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HORIZON Meeting",
  "version": "0.5.1",
  "identifier": "com.horizon.meeting",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HORIZON 会议中枢",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#030509",
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--ignore-gpu-blocklist --enable-gpu-rasterization",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Business",
    "shortDescription": "A focused meeting-room launcher for Windows.",
    "longDescription": "HORIZON 会议中枢：可自定义的会议大屏启动器，支持导入本机应用、快捷启动、全屏迎宾模式与内置智能白板。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../extension/": "extension/",
      "assets/snapdrop/": "snapdrop/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
